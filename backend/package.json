{
  "name": "imagesearch-backend",
  "version": "0.1.0",
  "description": "Local-first backend for ImageSearch (folders, scans, origins via SauceNAO/Fluffle).",
  "license": "MIT",
  "type": "commonjs",
  "packageManager": "bun@1.3.11",
  "trustedDependencies": [
    "argon2",
    "sharp"
  ],
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "migrate": "bun src/migrate.ts",
    "start": "bun dist/index.js",
    "build": "rm -rf dist && tsc -p tsconfig.json && bun scripts/copy-migrations.mjs",
    "lint": "eslint src test",
    "test": "bun test",
    "test:ci": "bun test",
    "worker": "bun src/worker.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.2",
    "argon2": "^0.44.0",
    "chokidar": "^5.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.1",
    "fastify": "^5.10.0",
    "file-type": "^22.0.1",
    "fluent-ffmpeg": "^2.1.2",
    "ipaddr.js": "^2.4.0",
    "mime-types": "^3.0.2",
    "pino": "^10.3.1",
    "sharp": "^0.35.3",
    "undici": "^8.7.0",
    "vite": "^8.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.8.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.7.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.4",
    "brace-expansion": "^5.0.8",
    "find-my-way": "^9.7.0",
    "postcss": "8.5.18"
  }
}
