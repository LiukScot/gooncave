# Copy this file to docker-compose.override.yml and add your own folders.
#
# GOONCAVE_USER_ID is the folder name under gooncave-library, available once
# you register. The host folder must be writable by Docker, or uploads and
# favorites sync fail — see the README for the chmod commands.
#
# The anchor keeps api and worker on the same mounts: the worker runs
# background scans and favorite downloads, so it needs to see the same files
# the api does.
x-media-volumes: &media-volumes
  - ${LOCAL_MEDIA_DIR}:/gooncave-library/users/${GOONCAVE_USER_ID}/downloads

services:
  api:
    volumes: *media-volumes
  worker:
    volumes: *media-volumes
