{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GoonCave",
  "identifier": "app.gooncave.ios",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "npm ci --prefix ../frontend && npm --prefix ../frontend run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "16.0",
      "frameworks": ["AVFoundation", "CoreMedia"]
    }
  }
}
