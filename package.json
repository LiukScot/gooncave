{
  "name": "imagesearch",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.11",
  "scripts": {
    "build": "cd backend && bun run build && cd ../frontend && bun run build",
    "dev": "concurrently -c \"cyan,magenta,green\" -n api,worker,web \"cd backend && PORT=4100 bun run dev\" \"cd backend && PORT=4100 bun run worker\" \"cd frontend && bun run dev\"",
    "lint": "cd backend && bun run lint && cd ../frontend && bun run lint",
    "prepare": "husky",
    "test:e2e": "bunx playwright test"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "eslint --fix --max-warnings=0"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "shell-quote": "^1.9.0"
  }
}
