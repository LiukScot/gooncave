{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GoonCave Shell Test",
  "version": "0.0.1",
  "identifier": "app.gooncave.shellspike",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GoonCave shell test",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
